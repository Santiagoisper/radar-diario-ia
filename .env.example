# Cliente (Vite; prefijo VITE_ expuesto al browser)
# false = usar API remota; true o sin definir = mock síncrono local
# VITE_USE_MOCK_DATA=false
# VITE_API_BASE_URL=http://localhost:3000
# VITE_SENTRY_DSN=

# Servidor (Vercel / solo api/*)
# DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
# CRON_SECRET=generar-valor-largo-aleatorio

# LLM — enriquecimiento de papers (opcional)
# Sin OPENAI_API_KEY el pipeline sigue funcionando; enrichments queda vacío en el snapshot.
# OPENAI_API_KEY=sk-...
# OPENAI_ENRICHMENT_MODEL=gpt-4.1-mini
# ARXIV_MAX_RESULTS=25
